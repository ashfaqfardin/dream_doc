                <mxCell id="28" value="③ create_harmonized_composite&#xa;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━&#xa;step 1 · LAB Luminance Transfer  (Reinhard 2001)&#xa;  extract L-channel from probe_region&#xa;  transfer mean+std → sketch obj (L only)&#xa;  object keeps real color; gets scene brightness&#xa;&#xa;step 2 · Poisson Seamless Clone  (Pérez, SIGGRAPH 2003)&#xa;  cv2.seamlessClone(NORMAL_CLONE)&#xa;  gradient-domain boundary → invisible seam" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=9;align=left;" parent="20" vertex="1">
